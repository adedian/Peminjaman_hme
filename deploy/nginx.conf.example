# Nginx + PHP-FPM — server block produksi untuk Peminjaman HME.
# Ganti: peminjaman.example.com, /var/www/hme-peminjaman, socket PHP-FPM, path sertifikat.

server {
    listen 80;
    server_name peminjaman.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name peminjaman.example.com;

    ssl_certificate     /etc/letsencrypt/live/peminjaman.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/peminjaman.example.com/privkey.pem;

    # Root WAJIB folder public/ — app/, storage/, database/, .env tidak pernah terjangkau web.
    root /var/www/hme-peminjaman/public;
    index index.php;
    server_tokens off;

    client_max_body_size 4m;          # foto maks. UPLOAD_MAX_BYTES (3 MB) + overhead

    # Berkas tersembunyi & ekstensi sensitif (Nginx tidak membaca .htaccess)
    location ~ /\. { deny all; }
    location ~* \.(env|sql|log|md|lock|json|ini|bak|zip)$ { deny all; }

    # Aset statis: URL memakai ?v=<mtime> sehingga aman di-cache lama
    location ~* \.(css|js|png|jpe?g|webp|svg|woff2?)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
    }

    # Front controller tunggal
    location / {
        try_files $uri /index.php$is_args$args;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_read_timeout 60s;
    }

    # Hanya index.php yang boleh dieksekusi sebagai PHP
    location ~ \.php$ { return 404; }
}
