; Pengaturan PHP yang disarankan di production (tempel di php.ini / .user.ini / "MultiPHP INI Editor" cPanel).
; Ekstensi wajib: pdo_mysql mbstring fileinfo gd zip openssl json ctype xml xmlreader
expose_php = Off
display_errors = Off
log_errors = On
; memory_limit: laporan Excel berfoto dan olah ulang foto
memory_limit = 256M
upload_max_filesize = 4M
post_max_size = 8M
max_execution_time = 60
date.timezone = Asia/Jakarta
session.cookie_secure = 1
