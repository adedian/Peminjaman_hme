# Salin menjadi .env lalu sesuaikan. JANGAN commit/unggah .env ke tempat publik.

# development | production
APP_ENV=production
# true hanya untuk development (diabaikan di production)
APP_DEBUG=false
# Kosong bila domain langsung ke folder public/. XAMPP: /Peminjaman_hme
APP_BASE_PATH=
# true bila di belakang proxy/CDN yang mengirim X-Forwarded-*
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hme_peminjaman
DB_USER=
DB_PASS=

# auto = Secure bila HTTPS
SESSION_SECURE=auto
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12

# poll | sse
REALTIME_MODE=poll
REALTIME_INTERVAL_MS=1500

UPLOAD_MAX_BYTES=3145728

# Opsional: simpan log di luar folder aplikasi (disarankan di production). Default: storage/logs
# LOG_DIR=
# Opsional: folder foto unggahan di luar folder aplikasi. Default: storage/uploads
# UPLOAD_DIR=
# Opsional: tujuan backup (tools/backup.php), disarankan di luar folder web. Default: storage/backups
# BACKUP_DIR=

# Email notifikasi admin (BR-12). Kosongkan MAIL_HOST bila belum ada akun SMTP: email dilewati & dicatat di log.
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls, MAIL_PASSWORD = App Password (bukan password akun).
# MAIL_DRIVER=log menulis email ke storage/logs/mail.log (development).
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Sistem Peminjaman HME"
# MAIL_DRIVER=log
